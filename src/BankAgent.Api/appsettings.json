{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "BankAgent": {
    "AgentVersion": "bank-agent/1.0.0",
    "SessionIdleTimeoutMinutes": 30,
    "SessionAbsoluteTimeoutHours": 8,
    "ApprovalValidityMinutes": 15,
    "DraftValidityHours": 24,
    "AgentRunTimeoutSeconds": 60,
    "UnmaskAnswersForRm": true
  },

  "Model": {
    "Provider": "AzureOpenAI",
    "Endpoint": "https://bak-agent.services.ai.azure.com/openai/v1",
    "DeploymentName": "gpt-5.6-luna",
    "ApiKey": "",
    "MaxOutputTokens": 1200
  },

  "Mcp": {
    "Endpoint": "http://localhost:5026/mcp",
    "ConnectionTimeoutSeconds": 10,
    "ClientCacheMinutes": 25
  },

  "PiiResolve": {
    "BaseUrl": "http://localhost:5026",
    "ResolvePath": "/vault/resolve",
    "TimeoutSeconds": 5
  },

  "ToolPolicy": {
    "MaxToolRounds": 3,
    "MaxReadToolRetries": 2,
    "ToolTimeoutSeconds": 20
  },

  "PiiGuard": {
    "DetectEmail": true,
    "DetectVietnamesePhone": true,
    "DetectNationalId": true,
    "DetectAccountNumber": true,
    "CanaryValues": []
  },

  "Rag": {
    "KnowledgeDirectory": "knowledge",
    "TopK": 5,
    "MaxChunks": 3,
    "ScoreThreshold": 0.15
  },

  "Audit": {
    "Directory": "audit",
    "AlsoWriteToLogger": true
  },

  "Auth": {
    "AllowDevHeaders": false,
    "RmIdClaim": "oid",
    "TenantIdClaim": "tid",
    "RolesClaim": "roles"
  },

  "Authorization": {
    "AllowUnmappedCustomers": false
  }
}
